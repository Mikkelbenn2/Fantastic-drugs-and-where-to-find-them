# Data, results, programs and databases never go into git (large, and not always ours to share).
# The empty folders are kept with .gitkeep files so the folder structure exists after cloning.
raw_data/*
!raw_data/.gitkeep
results/*
!results/.gitkeep
setup/envs/
setup/databases/
setup/*.log

# OS clutter
.DS_Store
__pycache__/
